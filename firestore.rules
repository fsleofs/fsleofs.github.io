rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{playerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /matches/{matchId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /quarters/{quarterId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
